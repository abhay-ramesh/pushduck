    {
      "fragment": "t/***.png",
      "ts": null,
      "python": "t/file-6372f7c8.png",
      "go": "t/file-6372f7c8.png",
      "note": "An all-stripped segment gets an FNV-1a fingerprint. TypeScript prints it in base 36, Python and Go in hex. Pre-existing in the default sanitiser."
    },
    {
      "fragment": "a/.../b",
      "ts": null,
      "python": "a/file-ac31c19/b",
      "go": "a/file-ac31c19/b",
      "note": "Same fingerprint encoding difference."
    },
    {
      "fragment": "a\u00adb.png",
      "ts": "a\u00adb.png",
      "python": null,
      "go": "a\u00adb.png",
      "note": "U+00AD SOFT HYPHEN is Unicode category Cf. Python rejects every Cf character; TypeScript and Go reject only Cc plus a fixed bidi/zero-width list."
    },
    {
      "fragment": "a\u2060b.png",
      "ts": "a\u2060b.png",
      "python": null,
