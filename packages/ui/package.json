{
    "name": "@pushduck/ui",
    "version": "0.1.7",
    "type": "module",
    "description": "React UI components for pushduck - File upload components you can copy and paste into your apps",
    "author": "Abhay Ramesh",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/abhay-ramesh/pushduck.git",
        "directory": "packages/ui"
    },
    "homepage": "https://pushduck.org",
    "keywords": [
        "react",
        "components",
        "ui",
        "file-upload",
        "s3",
        "nextjs",
        "tailwind",
        "typescript",
        "pushduck",
        "shadcn",
        "registry"
    ],
    "scripts": {
        "dev": "npx shadcn@canary build",
        "build": "pnpm build:registry",
        "build:registry": "npx shadcn@canary build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "files": [
        "public/r/**/*",
        "registry.json",
        "README.md"
    ],
    "dependencies": {
        "clsx": "^2.1.1",
        "lucide-react": "^0.564.0",
        "pushduck": "workspace:*",
        "tailwind-merge": "^3.6.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@typescript-eslint/eslint-plugin": "^8.69.0",
        "@typescript-eslint/parser": "^8.69.0",
        "@vitejs/plugin-react": "^5.2.0",
        "@vitest/coverage-v8": "^4.1.11",
        "eslint": "^9.39.5",
        "happy-dom": "^20.13.2",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.13",
        "typescript": "^5.9.3",
        "vitest": "^4.1.11"
    },
    "peerDependencies": {
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0",
        "tailwindcss": ">=3.0.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
