{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig/react-library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "moduleResolution": "bundler",
    "target": "es2022",
    "paths": {
      "@/*": [
        "./*"
      ],
      "pushduck": [
        "../pushduck/src/index.ts"
      ],
      "pushduck/client": [
        "../pushduck/src/client.ts"
      ]
    },
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".turbo",
    "public",
    "vitest.config.ts"
  ]
}
